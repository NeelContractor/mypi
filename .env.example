# Copy to .env and fill in what you use. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# What to talk to, without hunting through the code: these become the defaults
# for --provider and --model. A flag on the command line still wins.
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-5-5

# Let the file tools follow paths outside the current folder (off by default).
# MYPI_ALLOW_OUTSIDE=1
